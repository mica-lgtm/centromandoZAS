{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ads3/**",
              "ui_kits/email/**",
              "ui_kits/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Red Hat Display|Red Hat Text))/i]",
        "message": "Font not provided by the design system. Available: Red Hat Display, Red Hat Text."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-deep",
      "--bg",
      "--bg-alt",
      "--bg-block",
      "--bg-dark",
      "--btn-bg",
      "--btn-bg-hover",
      "--btn-fg",
      "--fg-on-dark",
      "--fg-on-dark-2",
      "--fg1",
      "--fg2",
      "--fg3",
      "--font-display",
      "--font-text",
      "--line",
      "--line-strong",
      "--r-lg",
      "--r-md",
      "--r-pill",
      "--r-sm",
      "--r-xl",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--simona-blush",
      "--simona-blush-deep",
      "--simona-blush-soft",
      "--simona-clay",
      "--simona-cream",
      "--simona-ink",
      "--simona-mocha",
      "--simona-sand",
      "--simona-stone",
      "--simona-taupe",
      "--simona-white",
      "--sp-1",
      "--sp-2",
      "--sp-3",
      "--sp-4",
      "--sp-5",
      "--sp-6",
